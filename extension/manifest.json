{
  "manifest_version": 3,
  "name": "Taskbeat",
  "short_name": "Taskbeat",
  "description": "Mostra e controla o aleatório e o repetir do YouTube Music no Taskbeat.",
  "version": "1.0.0",
  "minimum_chrome_version": "110",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "host_permissions": ["https://music.youtube.com/*"]
}
